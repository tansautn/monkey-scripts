Windows Registry Editor Version 5.00
[HKEY_CLASSES_ROOT\openwith]
"URL Protocol"=""
@="URL:Open With Default Browser"
[HKEY_CLASSES_ROOT\openwith\shell\open\command]
@="powershell -NoProfile -WindowStyle Hidden -Command \"$u=[uri]::UnescapeDataString(('%1' -replace '^openwith://',''));Start-Process $u\""